rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['userId', 'name', 'dob', 'time', 'place', 'gender', 'createdAt'])
        && data.keys().size() >= 7 && data.keys().size() <= 10
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.dob is string && data.dob.size() >= 8 && data.dob.size() <= 20
        && data.time is string && data.time.size() >= 3 && data.time.size() <= 10
        && data.place is string && data.place.size() > 0 && data.place.size() <= 200
        && data.gender is string && (data.gender == 'Nam' || data.gender == 'Nữ')
        && (!data.keys().hasAny(['timezone']) || (data.timezone is string && data.timezone.size() > 0));
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'profileId', 'profileSnapshot', 'report', 'model', 'createdAt'])
        && data.keys().size() == 6
        && data.userId == request.auth.uid
        && data.profileId is string
        && data.profileSnapshot is map
        && data.profileSnapshot.keys().hasAll(['name', 'dob', 'time', 'place', 'gender'])
        && data.report is map
        && data.report.keys().hasAll(['overview', 'numerology', 'astrology', 'tuvi', 'battu', 'humanDesign', 'yearlyForecast', 'remediation'])
        && data.model is string;
    }

    match /profiles/{profileId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidProfile(request.resource.data);
      allow update: if isOwner(request.resource.data.userId) && isValidProfile(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidReport(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
