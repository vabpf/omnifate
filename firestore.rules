rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global reusable helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'createdAt'])
        && data.keys().size() == 4
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidHistory(data) {
      return data.keys().hasAll(['userId', 'profile', 'createdAt'])
        && data.keys().size() == 3
        && data.userId == request.auth.uid
        && data.profile is map
        && data.profile.keys().hasAll(['name', 'dob', 'time', 'place', 'gender'])
        && data.profile.keys().size() == 5
        && data.profile.name is string && data.profile.name.size() > 0 && data.profile.name.size() <= 100
        && data.profile.dob is string && data.profile.dob.size() >= 8 && data.profile.dob.size() <= 20
        && data.profile.time is string && data.profile.time.size() >= 3 && data.profile.time.size() <= 10
        && data.profile.place is string && data.profile.place.size() > 0 && data.profile.place.size() <= 200
        && data.profile.gender is string && (data.profile.gender == 'Nam' || data.profile.gender == 'Nữ')
        && data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Users Collection rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // History / Saved Profiles Collection rules
    match /history/{historyId} {
      allow get, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidHistory(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidHistory(request.resource.data);
    }
  }
}
